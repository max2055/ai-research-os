# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# macOS
.DS_Store

# Source assets (per Source_Policy / Recovery_Runbook: raw source material is
# excluded from Git and backed up separately as an encrypted archive)
01_Inbox/_assets/

# Disposable derived stores (Rebuildable; never the authoritative source)
*.db
*.sqlite
*.sqlite3
*.jsonl

# Secrets and credentials
.env
.env.*
*.pem
*.key
*.crt
*.local.json

# Runtime logs (launchd sweep / scheduler output; regenerated each run)
09_Automation/launchd/logs/
